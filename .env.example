# ============================================================================
# OPSI 1: FULLSTACK STANDALONE (Saat di-hosting / pakai PostgreSQL sendiri)
# Isi DATABASE_URL dan SECRET_KEY di bawah ini untuk menjalankan database
# PostgreSQL langsung dari project Next.js ini tanpa butuh backend terpisah.
# ============================================================================
DATABASE_URL=
SECRET_KEY=atm-secret-key-2026

# ============================================================================
# OPSI 2: PROXY KE BACKEND EXISTING (Dipakai otomatis jika DATABASE_URL kosong)
# Karena request diteruskan oleh server Next.js (Server-to-Server), browser
# TIDAK AKAN terkena blokir CORS.
# ============================================================================
REMOTE_API_URL=https://apemsapi.sinergimp.co.id
NEXT_PUBLIC_API_URL=https://apemsapi.sinergimp.co.id
